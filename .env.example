# Copy to .env and fill in, or export these in your shell / MCP client env.

# Required: your OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Free vision models, tried in order (comma-separated). Primary first.
VISION_MODELS=nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,google/gemma-4-26b-a4b-it:free

# Cheap paid fallback tried last (so you still get an answer when free pool is rate-limited).
VISION_PAID_FALLBACK=z-ai/glm-5.3-flash:floor

# Optional tuning
VISION_ATTEMPTS=2
VISION_PAID_ATTEMPTS=3
# VISION_TIMEOUT_MS=90000
# VISION_MAX_MB=20
# VISION_ALLOWED_DIR=/abs/path/to/screenshots
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1